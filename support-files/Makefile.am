# bash command-line completion for the "apl" command itself (see apl's own
# header comment for what it does and does not cover). bashcompletiondir is
# set by ./configure (see configure.ac), preferring pkg-config's own idea of
# where bash-completion looks.
#
bashcompletiondir = @bashcompletiondir@
dist_bashcompletion_DATA = apl

