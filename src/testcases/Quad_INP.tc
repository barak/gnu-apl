      ⍝ monadic ⎕INP with axis
      ⍝
      Q←⎕INP[1] 'END-OF-⎕INP'
1, 2 2, 3 3 3, 4 4 4 4
'a', 'bb', 'ccc'
END-OF-⎕INP
      4 ⎕CR Q
┏→━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
┃┏→━━━━━━━━━━━━━━━━━━━━━━━━┓ ┏→━━━━━━━━━━━┓┃
┃┃1 ┏→━━┓ ┏→━━━━┓ ┏→━━━━━━┓┃ ┃a ┏→━┓ ┏→━━┓┃┃
┃┃  ┃2 2┃ ┃3 3 3┃ ┃4 4 4 4┃┃ ┃  ┃bb┃ ┃ccc┃┃┃
┃┃  ┗∼━━┛ ┗∼━━━━┛ ┗∼━━━━━━┛┃ ┃  ┗━━┛ ┗━━━┛┃┃
┃┗ϵ━━━━━━━━━━━━━━━━━━━━━━━━┛ ┗ϵ━━━━━━━━━━━┛┃
┗ϵϵ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛



      ⍝ dyadic ⎕INP
      ⍝
      Q← '<?apl' '?>' ⎕INP 'END-OF-⎕INP'
Hello ⎕INP
Index-6 is <?apl +/⍳6 ?> !
END-OF-⎕INP

      4 ⎕CR Q
┏→━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
┃┏→━━━━━━━━━┓ ┏→━━━━━━━━━━━━━━┓┃
┃┃Hello ⎕INP┃ ┃Index-6 is 21 !┃┃
┃┗━━━━━━━━━━┛ ┗━━━━━━━━━━━━━━━┛┃
┗ϵ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛

