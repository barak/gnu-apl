¯3
      0 →→ 'True' ←→ 'False' ←←
False
      0 →→  ←→ 'False' ←←   ⍝ empty THEN
SYNTAX ERROR+
      )MORE
empty →→ ... ←→ (aka. empty THEN)
      )SIC
      )CHECK BRIEF


