//════════════════════════════════════════════════════════════════════════════
inline const cValue *
Value_P_Base::get() const
{
   return value_p;
}
//════════════════════════════════════════════════════════════════════════════
inline int
cValue::get_owner_count() const
{
   return static_cast<const Value *>(this)->owner_count;
}
//════════════════════════════════════════════════════════════════════════════
inline const cValue &
Value_P_Base::operator*() const
{
   return *value_p;
}
//════════════════════════════════════════════════════════════════════════════
inline const cValue *
Value_P_Base::operator->() const
{
   return value_p;
}
//════════════════════════════════════════════════════════════════════════════
inline void
Value_P_Base::reset()
{
   if (value_p)
      {
        value_p->decrement_owner_count(LOC);
        value_p = 0;
      }
}
//──────────────────────────────────────────────────────────────────────────
inline void
Value_P_Base::clear(const char * loc)
{
  if (value_p)
     {
        // capture the post-decrement count BEFORE decrementing: if this
        // was the last owner, decrement_owner_count() does 'delete this'
        // -- value_p (the pointer variable) stays non-NULL, but what it
        // points to no longer exists, so re-reading value_p->owner_count
        // afterward (the old code below) was a use-after-free read.
        const int count_after = value_p->owner_count - 1;
        value_p->decrement_owner_count(LOC);
       ADD_EVENT(value_p, VHE_PtrClr, count_after, loc);
       (void)count_after;   // else unused without --with-value-history

       value_p = 0;
     }
}
//──────────────────────────────────────────────────────────────────────────
inline void
Value_P_Base::clear_pointer(const char * loc)
{
  if (value_p)
     {
       // do NOT decrement_owner_count() !
       ADD_EVENT(value_p, VHE_PtrClr,
                 value_p ? value_p->owner_count : -99, loc);

       value_p = 0;
     }
}
// ============================================================================

#include "Error.hh"

//════════════════════════════════════════════════════════════════════════════
inline Value_P::Value_P(const char * loc)
{
const char * args = "const char * loc";
   value_p = 0;

   try                           { value_p = new Value(loc); }
   catch (const Error & error)   { Value::catch_Error(error, loc, LOC);       }
   catch (const exception & e)   { Value::catch_exception(e, args, loc, LOC); }
   catch (...)                   { Value::catch_ANY(args, loc, LOC);          }

   value_p->increment_owner_count(loc);
   ADD_EVENT(value_p, VHE_PtrNew, value_p->owner_count, loc);
}
//──────────────────────────────────────────────────────────────────────────
inline Value_P::~Value_P()
{
   if (value_p)
      {
        // see Value_P_Base::clear() above for why this is captured
        // before decrementing, not re-read from value_p afterward.
        const int count_after = value_p->owner_count - 1;
        value_p->decrement_owner_count(LOC);
        ADD_EVENT(value_p, VHE_PtrDel, count_after, LOC);
        (void)count_after;   // else unused without --with-value-history
      }
}
