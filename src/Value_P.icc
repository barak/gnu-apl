//──────────────────────────────────────────────────────────────────────────
inline void
Value_P::operator =(const Value_P & other)
{
   if (value_p == other.value_p)   return;   // same pointer

   if (value_p)   // override existing pointer
      {
        value_p->decrement_owner_count(LOC);   // give up our (co-)ownership
        ADD_EVENT(value_p, VHE_PtrClr,
                  other.value_p ? other.value_p->owner_count : 0, LOC);
      }

   value_p = other.value_p;
   if (value_p)
      {
        value_p->increment_owner_count(LOC);   // take (co-)ownership
        ADD_EVENT(value_p, VHE_PtrCopy3, value_p->owner_count, LOC);
      }
}
//──────────────────────────────────────────────────────────────────────────
inline Value_P::Value_P(const Value_P & other, const char * loc)
{
   value_p = other.value_p;
   if (value_p)
      {
        value_p->increment_owner_count(loc);
        ADD_EVENT(value_p, VHE_PtrCopy, value_p->owner_count, loc);
      }
}
//──────────────────────────────────────────────────────────────────────────
inline Value_P::Value_P(const Value_P & other)
{
   value_p = other.value_p;
   if (value_p)
      {
        value_p->increment_owner_count(LOC);
        ADD_EVENT(value_p, VHE_PtrCopy, value_p->owner_count, LOC);
      }
}
//──────────────────────────────────────────────────────────────────────────
inline Value_P::Value_P(const Shape & shape, const char * loc)
{
const char * args = "const Shape & shape, const char * loc";
   value_p = 0;
   if (Value::check_WS_FULL(args, shape.get_volume(), loc))
      {
        MORE_ERROR() << "WS FULL detected by Value::check_WS_FULL()";
        WS_FULL;
      }

   try                           { value_p = new Value(shape, loc); }
   catch (const Error & error)   { Value::catch_Error(error, loc, LOC);       }
   catch (const exception & e)   { Value::catch_exception(e, args, loc, LOC); }
   catch (...)                   { Value::catch_ANY(args, loc, LOC);          }

   value_p->increment_owner_count(loc);
   ADD_EVENT(value_p, VHE_PtrNew, value_p->owner_count, loc);
}
//──────────────────────────────────────────────────────────────────────────
inline Value_P::Value_P(const Shape & shape, uint64_t * bits, const char * loc)
{
   // cannot WS_FULL since bits were allocated beforehand
   //
   value_p = new Value(shape, bits, loc);
   value_p->increment_owner_count(loc);
   ADD_EVENT(value_p, VHE_PtrNew, value_p->owner_count, loc);
}
//──────────────────────────────────────────────────────────────────────────
inline Value_P::Value_P(Value * val, const char * loc)
{
   value_p = val;
   value_p->increment_owner_count(loc);
   ADD_EVENT(value_p, VHE_PtrNew, value_p->owner_count, loc);
}
//════════════════════════════════════════════════════════════════════════════
inline void
Value_P_Base::isolate(const char * loc)
{
#ifdef NEW_CLONE
   if (value_p && value_p->get_owner_count() > 1)
      {
        Value_P Z = value_p->clone(loc);
        value_p->decrement_owner_count(LOC);
        value_p = Z.value_p;
        Z.value_p = 0;
      }
#endif
}
//──────────────────────────────────────────────────────────────────────────
inline void
Value_P_Base::isolate_deep(const char * loc)
{
#ifdef NEW_CLONE
   isolate(LOC);

   // This walk is the anchor point for depth-cache invalidation (see
   // plan.txt's 2026-09-01 analysis): every node visited here is a node
   // that could subsequently be mutated by whatever left-value assignment
   // is calling isolate_deep(), so marking each one dirty here is both
   // necessary (nothing outside this walk needs invalidating -- COW
   // guarantees a mutation can never reach a node this walk didn't visit)
   // and sufficient (every level between the top and the eventual write
   // gets invalidated, not just the endpoints). Free: the walk itself is
   // mandatory for COW correctness regardless of depth caching.
   //
   if (value_p)   value_p->invalidate_depth();

   // Packed ravels contain no PointerCells, so there is nothing to recurse
   // into.  Also, get_wravel(j) indexes 24-byte Cell slots which goes out of
   // bounds for sub-Cell packings (uint16_t, uint32_t, …).  Skip the loop.
   if (value_p && !value_p->is_packed())
      {
        loop(j, value_p->nz_element_count())
            {
              Cell & cell = value_p->get_wravel(j);
              if (cell.is_pointer_cell())
                 {
                   PointerCell & ptr = reinterpret_cast<PointerCell &>(cell);
                   ptr.isolate_deep(LOC);
                 }
            }
      }
#endif
}
//──────────────────────────────────────────────────────────────────────────
inline void
Value_P_Base::move(Value_P_Base & other, const char * loc)
{
   // Bugs8 #9 (Blake McBride): with &other == this, decrementing (and
   // possibly deleting) *this below, then re-reading other.value_p (the
   // same, now-dangling object) is a use-after-free. No known caller
   // does this, so this is hardening only.
   //
   if (this == &other)   return;

   if (value_p)   value_p->decrement_owner_count(loc);
   value_p = other.value_p;
   if (value_p)
      ADD_EVENT(value_p, VHE_TokMove, value_p->get_owner_count(), loc);

   other.value_p = 0;
}
