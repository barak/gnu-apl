      2 ⎕TF 'Z'⊣Z←'(?n)(?<o>a(?<i>x)?)b(c)' ⎕RE 'abc'
Z←2⍴'abc' (2⍴(1⍴'a') (''))



      2 ⎕TF 'Z'⊣Z←'(?n)(?<o>a(?<i>x)?)b(c)' ⎕RE 'axbc'
Z←2⍴'axbc' (2⍴'ax' (1⍴'x'))



      2 ⎕TF 'Z'⊣Z←'(a(x)?)(*MARK:q(r)b' ⎕RE 'ab'
Z←2⍴'ab' (2⍴(1⍴'a') (''))



      2 ⎕TF 'Z'⊣Z←'(a(x)?)(*MARK:q(r)b' ⎕RE 'axb'
Z←2⍴'axb' (2⍴'ax' (1⍴'x'))



      2 ⎕TF 'Z'⊣Z←'(a(x)?)(?C{q(r})b' ⎕RE 'ab'
Z←2⍴'ab' (2⍴(1⍴'a') (''))



      2 ⎕TF 'Z'⊣Z←'(a(b))' ⎕RE 'ab'
Z←2⍴'ab' (2⍴'ab' (1⍴'b'))



      2 ⎕TF 'Z'⊣Z←'(a(?C"x)")(b))' ⎕RE 'ab'
Z←2⍴'ab' (2⍴'ab' (1⍴'b'))



      2 ⎕TF 'Z'⊣Z←'(a[\Q]\E)(?]?(b))' ⎕RE 'a)b'
Z←2⍴'a)b' (2⍴'a)b' (1⍴'b'))



      2 ⎕TF 'Z'⊣Z←'(a(?C1)(b))' ⎕RE 'ab'
Z←2⍴'ab' (2⍴'ab' (1⍴'b'))



      2 ⎕TF 'Z'⊣Z←'(a(*pla:(b)))b' ⎕RE 'ab'
Z←2⍴'ab' (2⍴(1⍴'a') (1⍴'b'))



      2 ⎕TF 'Z'⊣Z←'(?n:(a)(?-n:(b)))' ⎕RE 'ab'
Z←2⍴'ab' (1⍴'b')



