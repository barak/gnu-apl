/* definition of APL commands and the functions that implement them.

   command:        the string for the command
   implementation: the Command::cmd_XXX() function that implements the commands
   arguments:      command arguments (in the )HELP command
   \t expansion:   TAB expansion hint (ExpandHint in TabExpansion.hh)

   keep it sorted in such a way that longer prefixes come first !!!
 */
//──────────────────────────────────────────────────────────────────────────────────────────────────────
//      command     ,  implementation                           ,argument(s)               ,\t expansion 
//──────────────────,────────,──────────────────────────────────,──────────────────────────,────────────
cmd_def(")CHECK_WS" , Cmd_WS::cmd_CHECK_WS(out, args)           ,"[[lib] wsname]"          ,oLIB_WSNAME)
cmd_def(")CHECK"    , Cmd_DIAG::cmd_CHECK(out, arg)             ,"[BRIEF]"                 ,NO_PARAM   )
cmd_def(")CLEAR"    , Cmd_WS::cmd_CLEAR(out)                    ,""                        ,NO_PARAM   )
cmd_def(")CONTINUE" , Cmd_WS::cmd_CONTINUE(out)                 ,""                        ,NO_PARAM   )
cmd_def(")COPY_ONCE", Cmd_WS::cmd_COPY_ONCE(out, args)          ,"[[lib] wsname]"          ,oLIB_WSNAME)
cmd_def(")COPY"     , Cmd_WS::cmd_COPY(out, args, false)        ,"[lib] wsname [object...]",oLIB_WSNAME)
cmd_def(")DROP"     , Cmd_WS::cmd_DROP(out, args)               ,"[lib] wsname"            ,oLIB_WSNAME)
cmd_def(")DUMP-HTML", Cmd_WS::cmd_DUMP(out, args, true,  false) ,"[[lib] wsname]"          ,oLIB_WSNAME)
cmd_def(")DUMPV"    , Cmd_WS::cmd_DUMP(out, args, false, false) ,"[[lib] wsname]"          ,oLIB_WSNAME)
cmd_def(")DUMP"     , Cmd_WS::cmd_DUMP(out, args, false, true)  ,"[[lib] wsname]"          ,oLIB_WSNAME)
cmd_def(")ERASE"    , Cmd_WS::cmd_ERASE(out, args)              ,"symbol ..."              ,SYMBOLS    )
cmd_def(")FNS"      , Cmd_LISTING::cmd_FNS(out, arg)            ,"[from-to]"               ,oFROM_oTO  )
cmd_def(")HELP"     , Cmd_HELP::cmd_HELP(out, arg)              ,"[primitive]"             ,PRIMITIVE  )
cmd_def(")HISTORY"  , Cmd_DIAG::cmd_HISTORY(out, arg)           ,"[CLEAR]"                 ,oCLEAR     )
cmd_def(")HOST"     , Cmd_HOST::cmd_HOST(out, arg)              ,"command ..."             ,HOSTCMD    )
cmd_def(")IN"       , Cmd_IN::cmd_IN(out, args, false)          ,"filename [object...]"    ,FILENAME   )
cmd_def(")LIBS"     , Cmd_LIB::cmd_LIBS(out, args)              ,"[[lib] path]"            ,oLIB_oPATH )
cmd_def(")LIB"      , Cmd_LIB::cmd_LIB1(out, args)              ,"[lib|path] [from-to]"    ,DIR_OR_LIB )
cmd_def(")LOAD"     , Cmd_WS::cmd_LOAD(out, args, line, false)  ,"[lib] wsname"            ,oLIB_WSNAME)
cmd_def(")MORE"     , Cmd_SESSION::cmd_MORE(out, args)          ,"[AUTO [ON|OFF]]"         ,oAUTO      )
cmd_def(")NMS"      , Cmd_LISTING::cmd_NMS(out, arg)            ,"[from-to]"               ,oFROM_oTO  )
cmd_def(")OFF"      , Command::cmd_OFF(out, arg)                ,"[exit_code]"             ,COUNT      )
cmd_def(")OPS"      , Cmd_LISTING::cmd_OPS(out, arg)            ,"[from-to]"               ,oFROM_oTO  )
cmd_def(")OUT"      , Cmd_WS::cmd_OUT(out, args)                ,"filename [object...]"    ,FILENAME   )
cmd_def(")PCOPY"    , Cmd_WS::cmd_COPY(out, args, true)         ,"[lib] wsname [object]"   ,oLIB_WSNAME)
cmd_def(")PIN"      , Cmd_IN::cmd_IN(out, args, true)           ,"filename [object...]"    ,FILENAME   )
cmd_def(")QLOAD"    , Cmd_WS::cmd_LOAD(out, args, line, true)   ,"[lib] wsname"            ,oLIB_WSNAME)
cmd_def(")RESET"    , Cmd_SI::cmd_SIC(out)                      ,""                        ,NO_PARAM   )
cmd_def(")SAVE"     , Cmd_WS::cmd_SAVE(out, args)               ,"[[lib] wsname]"          ,oLIB_WSNAME)
cmd_def(")SIC"      , Cmd_SI::cmd_SIC(out)                      ,""                        ,NO_PARAM   )
cmd_def(")SINL"     , Cmd_SI::cmd_SINL(out)                     ,""                        ,NO_PARAM   )
cmd_def(")SIS"      , Cmd_SI::cmd_SIS(out, false)                ,""                        ,NO_PARAM   )
cmd_def(")SI"       , Cmd_SI::cmd_SI(out, false)                 ,""                        ,NO_PARAM   )
cmd_def(")SYMBOLS"  , Cmd_LISTING::cmd_SYMBOLS(out, arg)        ,""                        ,NO_PARAM   )
cmd_def(")VALUES"   , Cmd_LISTING::cmd_VALUES(out)              ,""                        ,NO_PARAM   )
cmd_def(")VARS"     , Cmd_LISTING::cmd_VARS(out, arg)           ,"[from-to]"               ,oFROM_oTO  )
cmd_def(")WSID"     , Cmd_WS::cmd_WSID(out, args)               ,"[[lib] wsname]"          ,oLIB_WSNAME)

cmd_def("]AV"       , Cmd_SESSION::cmd_AV(out)                  ,""                        ,NO_PARAM   )
cmd_def("]BOXING"   , Cmd_SESSION::cmd_BOXING(out, arg)         ,"[OFF|[-]2-4|[-]7-9|[-]20-25|[-]29]" ,BOXING     )
cmd_def("]COLOR"    , Cmd_SESSION::cmd_XTERM(out, arg)          ,"[ON|OFF]"                ,oON_OFF    )
cmd_def("]DOXY"     , Cmd_DIAG::cmd_DOXY(out, args)             ,"[path]"                  ,oPATH      )
cmd_def("]EXPECT"   , Cmd_SESSION::cmd_EXPECT(out, arg)         ,"error_count"             ,COUNT      )
cmd_def("]FILE_CTL" , Cmd_HOST::cmd_FILE_CTL(out, args)         ,"[NO_SKIP|SKIP_GNU|SKIP_APL2|SKIP_ALL]",CONFIG)
cmd_def("]HELP"     , Cmd_HELP::cmd_HELP(out, arg)              ,"[primitive]"             ,NO_PARAM   )
cmd_def("]KEYB"     , Cmd_KEYB::cmd_KEYB(out, args)             ,"[XMOD|XKBD|GUESS] [KEYS] [CURS] [KPAD] [FUNK]" ,oKEYB  )
cmd_def("]LIB"      , Cmd_LIB::cmd_LIB2(out, args)              ,"[lib|path] [from-to]"    ,DIR_OR_LIB )
cmd_def("]LOG"      , Cmd_SESSION::cmd_LOG(out, arg)            ,"[facility|ON|OFF] ..."   ,LOG_NUM    )
cmd_def("]NEXTFILE" , Cmd_HOST::cmd_NEXTFILE(out, args)         ,"[cond ...]"              ,CONFIG     )
cmd_def("]OPTIM"    , Cmd_DIAG::cmd_OPTIM(out, arg)             ,"[CLEAR]"                 ,PRIMITIVE  )
cmd_def("]OWNERS"   , Cmd_LISTING::cmd_OWNERS(out)              ,""                        ,NO_PARAM   )
cmd_def("]PUSHFILE" , Cmd_HOST::cmd_PUSHFILE()                  ,""                        ,NO_PARAM   )
cmd_def("]PSTAT"    , Cmd_DIAG::cmd_PSTAT(out, arg)             ,"[CLEAR|SAVE]"            ,oCLEAR_SAVE)
cmd_def("]SIS"      , Cmd_SI::cmd_SIS(out, true)                ,""                        ,NO_PARAM   )
cmd_def("]SI"       , Cmd_SI::cmd_SI(out, true)                 ,""                        ,NO_PARAM   )
cmd_def("]STATUS"   , Cmd_DIAG::cmd_STATUS(out)                 ,""                        ,NO_PARAM   )
cmd_def("]SVARS"    , Cmd_LISTING::cmd_SVARS(out)               ,""                        ,NO_PARAM   )
cmd_def("]SYMBOL"   , Cmd_LISTING::cmd_SYMBOL(out, arg)         ,"symbol"                  ,SYMNAME    )
cmd_def("]USERCMD"  , Cmd_USERCMD::cmd_USERCMD(out, arg, args)  ,"[ ]ucmd APL_fun [mode]"  ,UCOMMAND   )
cmd_def("        "  , _NO_OP_                                   ,""                        ,NO_PARAM   )
cmd_def("        "  , _NO_OP_                                   ,"| ]ucmd { ... }"         ,NO_PARAM   )
cmd_def("        "  , _NO_OP_                                   ,""                        ,NO_PARAM   )
cmd_def("        "  , _NO_OP_                                   ,"| REMOVE ]ucmd"          ,NO_PARAM   )
cmd_def("        "  , _NO_OP_                                   ,""                        ,NO_PARAM   )
cmd_def("        "  , _NO_OP_                                   ,"| REMOVE-ALL"            ,NO_PARAM   )
cmd_def("        "  , _NO_OP_                                   ,""                        ,NO_PARAM   )
cmd_def("        "  , _NO_OP_                                   ,"]"                       ,NO_PARAM   )
cmd_def("]XTERM"    , Cmd_SESSION::cmd_XTERM(out, arg)          ,"[ON|OFF]"                ,oON_OFF    )
//──────────────────────────────────────────────────────────────────────────────────────────────────────

#undef cmd_def
