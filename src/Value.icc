//──────────────────────────────────────────────────────────────────────────
void
Value::depth_update_for_overwrite(ShapeItem offset, int new_sub_depth)
// Update the depth cache when ravel[offset] is about to be overwritten.
// new_sub_depth: -1 = new cell is simple; >=0 = PointerCell to sub of that depth.
// Call BEFORE the actual write.
// Only Simple→Simple is a safe no-op; any PointerCell involvement marks dirty,
// because sub-value depth may change later (no parent pointers to propagate).
{
   if (flags.value_depth == VF_DEPTH_DIRTY)   return;   // already dirty
   Cell cache;
   if (!get_cravel(offset, cache).is_pointer_cell() && new_sub_depth < 0)
      return;   // Simple → Simple: depth cannot change
   flags.value_depth = VF_DEPTH_DIRTY;
}
//──────────────────────────────────────────────────────────────────────────
void
Value::next_ravel_Pointer(Value * value)
{
   flags.value_depth = VF_DEPTH_DIRTY;
   Assert(!value->is_simple_scalar());
   new (next_ravel()) PointerCell(value, *this);
}
//──────────────────────────────────────────────────────────────────────────
void
Value::next_ravel_Pointer(Value * value, uint32_t magic)
{
   flags.value_depth = VF_DEPTH_DIRTY;
   Assert(!value->is_simple_scalar());
   new (next_ravel()) PointerCell(value, *this, magic);
}
//──────────────────────────────────────────────────────────────────────────
void
Value::next_ravel_Value(Value * value)
{
   // Strand-notation construction: A B C ←→ (⊂A),(⊂B),⊂C (ISO/IEC 13751
   // 10.2.26, IBM APL2 LRM p.14/136). ⊂ (enclose) is the identity ONLY on
   // a *simple* scalar (depth 0); a nested/enclosed scalar (e.g. X←⊂1 2 3,
   // depth 2) is NOT its own enclose -- ⊂X must add one more level of
   // nesting, same as an explicit ⊂X would. A value->is_scalar() check
   // here (accepting simple OR nested scalars) therefore drops that extra
   // level for any strand item that is already an enclosed scalar:
   // confirmed directly against both the LRM (p.136, "B←(2 3 4) 5
   // (⊂7 8 (9 10 11))" wants ≡B=4, GNU APL gave 3) and the ISO/IEC 13751
   // depth definition (10.2.5) by hand. Only a *simple* scalar's sole
   // cell can be safely reused as-is; anything else, including an
   // already-nested scalar, needs a fresh PointerCell.
   //
   if (value->is_simple_scalar())
      { Cell cache; next_ravel_Cell(value->get_cfirst(cache)); }
   else
      {
        flags.value_depth = VF_DEPTH_DIRTY;
        new (next_ravel()) PointerCell(value, *this);
      }
}
//──────────────────────────────────────────────────────────────────────────
void
Value::next_ravel_Lval(Cell * target, Value * target_owner)
{
  new (next_ravel()) LvalCell(target, target_owner);
}
//──────────────────────────────────────────────────────────────────────────
void
Value::next_ravel_Cell(const Cell & other)
{
   if (other.is_pointer_cell())   flags.value_depth = VF_DEPTH_DIRTY;
   other.init_other(next_ravel(), *this, LOC);
}
//──────────────────────────────────────────────────────────────────────────
void
Value::next_ravel_Proto(const Cell & cell)
{
  Cell::init_type_at(next_ravel(), cell, *this, LOC);
}
//──────────────────────────────────────────────────────────────────────────
//──────────────────────────────────────────────────────────────────────────
void
Value::set_ravel_Char(ShapeItem offset, Unicode uni)
{
   depth_update_for_overwrite(offset, -1);
   new (&get_wravel(offset))   CharCell(uni);
}
//──────────────────────────────────────────────────────────────────────────
void
Value::set_ravel_Int(ShapeItem offset, APL_Integer aint)
{
   depth_update_for_overwrite(offset, -1);
   new (&get_wravel(offset))   IntCell(aint);
}
//──────────────────────────────────────────────────────────────────────────
void
Value::set_ravel_Float(ShapeItem offset, APL_Float flt)
{
   depth_update_for_overwrite(offset, -1);
   new (&get_wravel(offset))   FloatCell(flt);
}
//──────────────────────────────────────────────────────────────────────────
void
Value::set_ravel_Complex(ShapeItem offset, APL_Float real, APL_Float imag)
{
   depth_update_for_overwrite(offset, -1);
   new (&get_wravel(offset))   ComplexCell(real, imag);
}
//──────────────────────────────────────────────────────────────────────────
void
Value::set_ravel_Cell(ShapeItem offset, const Cell & cell)
{
   depth_update_for_overwrite(offset, cell.is_pointer_cell() ? 0 : -1);
   // get_wravel(offset) is raw ravel storage with no live Cell yet --
   // init_other() (called on the live source) is the safe direction,
   // not a non-static member call on the destination (Bugs15 #12).
   //
   cell.init_other(&get_wravel(offset), *this, LOC);
}
//──────────────────────────────────────────────────────────────────────────
void
Value::set_ravel_Pointer(ShapeItem offset, Value * value)
{
   Assert(!value->is_simple_scalar());
   depth_update_for_overwrite(offset, 0);   // PointerCell → dirty
   new (&get_wravel(offset))   PointerCell(value, *this);
}
//──────────────────────────────────────────────────────────────────────────
void
Value::set_ravel_Value(ShapeItem offset, Value * value)
{
   if (value->is_simple_scalar())
      {
        depth_update_for_overwrite(offset, -1);
        Cell cache;
        value->get_cfirst(cache).init_other(&get_wravel(offset), *this, LOC);
      }
   else
      {
        depth_update_for_overwrite(offset, 0);   // PointerCell → dirty
        new (&get_wravel(offset)) PointerCell(value, *this);
      }
}
//════════════════════════════════════════════════════════════════════════════
#endif // __VALUE_ICC_DEFINED__
