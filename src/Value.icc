#include "Value.hh"

//════════════════════════════════════════════════════════════════════════════
void
Value::set_proto_Spc()
{
  if (is_empty())   CharCell::zU(&get_wproto(), UNI_SPACE);
}
//──────────────────────────────────────────────────────────────────────────
void
Value::set_proto_Int()
{
  if (is_empty())   IntCell::z0(&get_wproto());
}
//──────────────────────────────────────────────────────────────────────────
void
Value::release(ShapeItem offset, const char * loc)
{
   get_wravel(offset).release(loc);
}
//──────────────────────────────────────────────────────────────────────────
void
Value::set_default(const Value & B, const char * loc)
{
  if (is_empty())
     {
       Cell proto_cache;
       Assert1(this->get_cproto(proto_cache).is_integer_cell());  // by constructor
       Cell cache;
       const Cell & cell = B.get_cproto(cache);
       if (cell.is_lval_cell())   new (&get_wproto()) LvalCell(0, 0);
       else                       Cell::init_type_at(&get_wproto(), cell,
                                                      *this, loc);
     }
}
//──────────────────────────────────────────────────────────────────────────
void
Value::set_default(const cValue & B, const char * loc)
{
  if (is_empty())
     {
       Cell proto_cache;
       Assert1(this->get_cproto(proto_cache).is_integer_cell());  // by constructor
       Cell cache;
       const Cell & cell = B.get_cproto(cache);
       if (cell.is_lval_cell())   new (&get_wproto()) LvalCell(0, 0);
       else                       Cell::init_type_at(&get_wproto(), cell,
                                                      *this, loc);
     }
}
//──────────────────────────────────────────────────────────────────────────
void
Value::set_default(const Cell & cB, const char * loc)
{
   Cell proto_cache;
   Assert1(this->get_cproto(proto_cache).is_integer_cell());   // by constructor
   if (cB.is_lval_cell())   new (&get_wproto()) LvalCell(0, 0);
   else                     Cell::init_type_at(&get_wproto(), cB, *this, loc);
}
