From: =?utf-8?b?IkRyLiBKw7xyZ2VuIFNhdWVybWFubiI=?= <bug-apl@gnu.org>
Date: Wed, 29 Jul 2026 15:15:00 +0200
Subject: fix QR factorization crash: do not mutate const Matrix members
MIME-Version: 1.0
Content-Type: text/plain; charset="utf-8"
Content-Transfer-Encoding: 8bit

Bif_F12_DOMINO::Matrix declared M, N and dY const, but resize(),
drop_1_1(), operator=() and init_inner_product() changed them by
placement-new over *this.  That is undefined behaviour; with current
GCC the stale values are used and QR factorization (⌹[⎕CT]B) segfaults.
Make the members non-const and assign them directly.

Origin: upstream, commit 89b1e88f97586dc40ddb642c731906a8af2cb871 (SVN trunk)
Applied-Upstream: commit 89b1e88f97586dc40ddb642c731906a8af2cb871
---
 src/Bif_F12_DOMINO.hh | 20 +++++++++++++-------
 1 file changed, 13 insertions(+), 7 deletions(-)

diff --git a/src/Bif_F12_DOMINO.hh b/src/Bif_F12_DOMINO.hh
index c3135f6..840c4aa 100644
--- a/src/Bif_F12_DOMINO.hh
+++ b/src/Bif_F12_DOMINO.hh
@@ -188,7 +188,7 @@ public:
 
        /// resize a (nulti-purpose) matrix to size M×N
        inline void resize(ShapeItem M, ShapeItem N)
-          { new (this)   Matrix<cplx>(data, M, N); }
+          { this->M = M;   this->N = N;   dY = dpi*N; }
 
        /// return the real part of A[x;y]
        double & real(ShapeItem y, ShapeItem x)
@@ -216,7 +216,9 @@ public:
 
        /// return the elements of matrix 1 1↓this
        inline double * drop_1_1()
-          { new (this)   Matrix<cplx>(data + dpi*(N + 1), M-1, N-1, dY);
+          { data = data + dpi*(N + 1);   // uses old N; must run before N--
+            --M;
+            --N;                         // dY (stride) is unchanged
             return data; }
 
        /// return the real part of A[x;y]
@@ -319,13 +321,13 @@ public:
 
        public:
        /// the number of matrix rows
-       const ShapeItem M;
+       ShapeItem M;
 
        /// the number of matrix columns
-       const ShapeItem N;
+       ShapeItem N;
 
        /// the distance (in doubles) between  A[i;j] and A[i+1;j]
-       const ShapeItem dY;
+       ShapeItem dY;
      };
 };
 
@@ -594,7 +596,9 @@ Bif_F12_DOMINO::Matrix<true>::operator =(const Matrix<true> & src)
 {
    matrix_assert(M == src.M);
    matrix_assert(N == src.N);
-   new(this)   Matrix<true>(data, src.M, src.N);
+   M = src.M;
+   N = src.N;
+   dY = dpi*N;
    loop(y, src.M) loop(x, src.N)
        {
          real(y, x) = src.real(y, x);
@@ -634,7 +638,9 @@ const ShapeItem Z = src_A.N;
    matrix_assert(N == src_B.N);
    matrix_assert(Z == src_A.N);
    matrix_assert(Z == src_B.M);
-   new (this) Matrix<true>(data, src_A.M, src_B.N);
+   M = src_A.M;
+   N = src_B.N;
+   dY = dpi*N;
 
    loop(y, src_A.M)   // for every row y of src_A
    loop(x, src_B.N)   // for every column x of src_B
