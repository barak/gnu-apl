From: "Barak A. Pearlmutter" <barak+git@pearlmutter.net>
Date: Wed, 4 Nov 2026 12:00:00 +0000
Subject: take the socket constants of FIO∆SockHelper from the target's headers

The table of socket constants in FIO∆SockHelper (wslib5/FILE_IO.apl and
FILE_IO1.apl) was generated once by tools/sockconst on x86 GNU/Linux,
but the values differ between architectures: SOL_SOCKET and
SO_REUSEADDR are 0xFFFF and 4 on alpha, hppa, mips and sparc instead
of 1 and 2, SOCK_NONBLOCK and SOCK_CLOEXEC vary, and on mips
SOCK_STREAM and SOCK_DGRAM are swapped.  Compute the values with
AC_COMPUTE_INT in configure (which also works when cross compiling)
and substitute them into the installed FILE_IO.apl and FILE_IO1.apl,
dropping constants the target lacks.

Also make File_IO.tc and Quad_FIO.tc get AF_INET, SOCK_STREAM,
IPPROTO_IP, SOL_SOCKET and SO_REUSEADDR from FIO∆SockHelper instead of
hard-coding the asm-generic values.  With the wrong SOL_SOCKET on
sparc64, setsockopt() failed, bind() could then fail with EADDRINUSE,
and accept() blocked forever, hanging the test run.

A comment in configure.ac describes a better long term fix: a ⎕FIO
function that looks constants up in a table compiled into the
interpreter.

Forwarded: no
---
--- a/configure.ac
+++ b/configure.ac
@@ -485,6 +485,70 @@
 fi
 AC_MSG_RESULT([$cfg_CTRLD_DEL])
 
+apl_TOPIC([socket constants for wslib5/FILE_IO.apl])
+
+# FIO∆SockHelper in wslib5/FILE_IO.apl and wslib5/FILE_IO1.apl maps
+# names like 'SOL_SOCKET' to their numeric values, using a table that
+# tools/sockconst.c once generated on x86 GNU/Linux.  But the values
+# are not the same everywhere: SOL_SOCKET and SO_REUSEADDR are 1 and 2
+# in asm-generic/socket.h, but 0xFFFF and 4 on alpha, hppa, mips and
+# sparc, other SO_ options and SOCK_NONBLOCK/SOCK_CLOEXEC also vary,
+# and on mips even SOCK_STREAM and SOCK_DGRAM are swapped.  They also
+# differ on other kernels.
+#
+# Compute the values for the target here, with AC_COMPUTE_INT, which
+# works when cross compiling (unlike running tools/sockconst), and
+# have wslib5/Makefile substitute them into the installed copies of
+# FILE_IO.apl and FILE_IO1.apl.  Constants that the target does not
+# define are removed from the table, so that FIO∆SockHelper returns
+# their names unchanged and the socket function that gets the name
+# fails, rather than silently using a wrong number.
+#
+# A better long term solution would be to have the interpreter itself
+# provide these values, since it is compiled against the right headers
+# anyway: a new ⎕FIO function, say Zi ← ⎕FIO[N] Bs, that looks Bs
+# ('AF_INET', 'SOL_SOCKET', ...) up in a table compiled into
+# Quad_FIO.cc from the same list of names as tools/sockconst.c (each
+# entry guarded by #ifdef) and returns its value, or DOMAIN ERROR for
+# an unknown name.  FIO∆SockHelper would then simply call it, the
+# generated table in FILE_IO.apl and FILE_IO1.apl and this configure
+# check would go away, the wslib5 files would again be the same on all
+# platforms, and APL programs could also use names that are not in
+# the table (e.g. other SO_ or IPPROTO_ options, or MSG_ flags for
+# FIO∆send and FIO∆recv) without hard-coding their values.  That is a
+# change to the ⎕FIO API, though, and so for upstream to decide.
+#
+apl_socket_sed=
+for apl_const in AF_UNSPEC AF_LOCAL AF_UNIX AF_INET AF_SNA AF_DECnet  \
+       AF_APPLETALK AF_ROUTE AF_IPX AF_ISDN AF_INET6 AF_BLUETOOTH AF_MAX \
+       PF_INET PF_LOCAL PF_UNIX SOCK_STREAM SOCK_DGRAM SOCK_RAW SOCK_RDM  \
+       SOCK_SEQPACKET SOCK_DCCP SOCK_PACKET SOCK_CLOEXEC SOCK_NONBLOCK    \
+       IPPROTO_IP IPPROTO_ICMP IPPROTO_IPIP IPPROTO_TCP IPPROTO_PUP       \
+       IPPROTO_UDP IPPROTO_IDP IPPROTO_TP IPPROTO_DCCP IPPROTO_IPV6       \
+       IPPROTO_ROUTING IPPROTO_FRAGMENT IPPROTO_RSVP IPPROTO_GRE          \
+       IPPROTO_ESP IPPROTO_AH IPPROTO_ICMPV6 IPPROTO_NONE IPPROTO_DSTOPTS \
+       IPPROTO_MTP IPPROTO_ENCAP IPPROTO_PIM IPPROTO_COMP IPPROTO_SCTP    \
+       IPPROTO_UDPLITE IPPROTO_RAW SOL_SOCKET SO_BINDTODEVICE             \
+       SO_REUSEADDR SO_BROADCAST INADDR_ANY
+do
+   AC_MSG_CHECKING([the value of $apl_const])
+   AC_COMPUTE_INT([apl_val], [$apl_const],
+                  [#include <sys/types.h>
+#include <sys/socket.h>
+#include <netinet/in.h>],
+                  [apl_val=])
+   # sed commands on the table lines, which look like: t←t⍪'AF_INET' 2
+   if test -n "$apl_val"; then
+      AC_MSG_RESULT([$apl_val])
+      apl_socket_sed="$apl_socket_sed/^t.*.$apl_const. /s/ [[0-9]][[0-9]]*/ $apl_val/;"
+   else
+      AC_MSG_RESULT([not defined])
+      apl_socket_sed="$apl_socket_sed/^t.*.$apl_const. /d;"
+   fi
+done
+AC_SUBST([APL_SOCKET_SED], [$apl_socket_sed])
+AC_PROG_SED
+
 m4_include([m4/apl_TARGETs.m4])
 
 AC_CONFIG_FILES([Makefile
--- a/src/testcases/File_IO.tc
+++ b/src/testcases/File_IO.tc
@@ -166,9 +166,9 @@
       ⍝ socket communication: send 'Hello' from one socket to another
       ⍝ and 'World!' back.
       ⍝
-      AF_INET     ← 2           ⍝ see /usr/include/.../bits/socket.h
-      SOCK_STREAM ← 1           ⍝ see /usr/include/.../bits/socket_type.h
-      IPPROTO_IP       ← 0      ⍝ see /usr/include/netinet/in.h
+      AF_INET     ← FIO∆SockHelper 'AF_INET'
+      SOCK_STREAM ← FIO∆SockHelper 'SOCK_STREAM'
+      IPPROTO_IP  ← FIO∆SockHelper 'IPPROTO_IP'
       LOCALHOST←256⊥127 0 0 1   ⍝ 127.0.0.1 in host byte order
       Port ← 22222
       Server←AF_INET, LOCALHOST, Port
@@ -180,8 +180,8 @@
 
       ⍝ setsockopt(Handle, SOL_SOCKET, SO_REUSEADDR, 1)
       ⍝
-      SOL_SOCKET←1              ⍝ see /usr/include/asm-generic/socket.h
-      SO_REUSEADDR←2            ⍝ see /usr/include/asm-generic/socket.h
+      SOL_SOCKET   ← FIO∆SockHelper 'SOL_SOCKET'
+      SO_REUSEADDR ← FIO∆SockHelper 'SO_REUSEADDR'
       (SOL_SOCKET, SO_REUSEADDR, 1) FIO∆setsockopt Handle
 0
 
--- a/src/testcases/Quad_FIO.tc
+++ b/src/testcases/Quad_FIO.tc
@@ -175,9 +175,9 @@
       ⍝ socket communication: send 'Hello' from one socket to another socket
       ⍝ and send 'World!' back.
       ⍝
-      AF_INET     ← 2           ⍝ see /usr/include/.../bits/socket.h
-      SOCK_STREAM ← 1           ⍝ see /usr/include/.../bits/socket_type.h
-      IPPROTO_IP       ← 0      ⍝ see /usr/include/netinet/in.h
