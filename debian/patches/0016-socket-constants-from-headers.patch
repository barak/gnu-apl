--- a/wslib5/Makefile.am
+++ b/wslib5/Makefile.am
@@ -4,13 +4,29 @@
 dist_apl5_DATA = 	\
     HTML.apl     	\
     ASSERT.apl   	\
-    FILE_IO.apl  	\
-    FILE_IO1.apl 	\
 	ISO-13751.apl	\
     SQL.apl
 
 apl5dir = $(pkglibdir)/wslib5
 
+# FILE_IO.apl and FILE_IO1.apl are installed with the socket constants
+# of the target (as computed by configure) in FIO∆SockHelper.  They are
+# generated in a subdirectory so that they do not clash with the
+# originals when building in the source directory; automake installs
+# them under their base names.
+#
+EXTRA_DIST = FILE_IO.apl FILE_IO1.apl
+nodist_apl5_DATA = sock/FILE_IO.apl sock/FILE_IO1.apl
+CLEANFILES = $(nodist_apl5_DATA)
+
+sock/FILE_IO.apl: $(srcdir)/FILE_IO.apl Makefile
+	$(MKDIR_P) sock
+	$(AM_V_GEN)$(SED) -e '$(APL_SOCKET_SED)' $(srcdir)/FILE_IO.apl > $@
+
+sock/FILE_IO1.apl: $(srcdir)/FILE_IO1.apl Makefile
+	$(MKDIR_P) sock
+	$(AM_V_GEN)$(SED) -e '$(APL_SOCKET_SED)' $(srcdir)/FILE_IO1.apl > $@
+
 .PHONY: git-pull
 git-pull:
 	make -C APLComponentFiles $@
