From: "Barak A. Pearlmutter" <barak+git@pearlmutter.net>
Date: Tue, 3 Nov 2026 22:00:00 +0000
Subject: expand ${prefix} in --libdir; take wslib LIBREFs from libdir

configure copied directories given on its command line verbatim into
config.h.  dh_auto_configure passes --libdir=${prefix}/lib/<triplet>,
so apl --show_lib_dir printed "${prefix}/lib/x86_64-linux-gnu/apl", and
NativeFunction.cc looked for native libraries (lib_file_io.so etc.)
there before falling back to /usr/lib/apl.  Expand ${prefix},
${exec_prefix} and ${datarootdir} in the computed directories.

Also, gnu-apl.d/preferences set LIBREF-3/4/5 to @prefix@/lib/apl/wslibN,
while wslibN are installed into $(pkglibdir) = $(libdir)/apl.  With any
--libdir other than PREFIX/lib, e.g. Debian's multiarch libdir, )LIBS
showed libraries 3-5 as missing and e.g. )LOAD 5 FILE_IO failed.  Use
the (expanded) libdir there.

Forwarded: no
---
--- a/configure.ac
+++ b/configure.ac
@@ -923,6 +923,23 @@
    AS_ECHO(["   --sysconfdir overwrite: ${apl_sysconfdir}"])
 fi
 
+# directories given on the command line may refer to ${prefix} and friends,
+# e.g. dh_auto_configure passes --libdir=${prefix}/lib/<multiarch triplet>.
+# Expand them, since they end up in config.h and in gnu-apl.d/preferences,
+# where nobody expands them later on.
+#
+for apl_dir in apl_bindir apl_datarootdir apl_docdir apl_libdir \
+               apl_localedir apl_sysconfdir
+do
+   eval apl_val=\$$apl_dir
+   apl_val=$(prefix="$apl_prefix"
+             exec_prefix="$apl_exec_prefix"
+             datarootdir="$apl_datarootdir"
+             eval echo "\"$apl_val\"")
+   eval $apl_dir=\$apl_val
+done
+AC_SUBST([apl_libdir])
+
 AC_DEFINE_UNQUOTED(apl_DIR__bin,         "$apl_bindir",      [--bindir]        )
 AC_DEFINE_UNQUOTED(apl_DIR__datarootdir, "$apl_datarootdir", [--datarootdir]   )
 AC_DEFINE_UNQUOTED(apl_DIR__doc,         "$apl_docdir",      [--docdir]        )
--- a/gnu-apl.d/preferences.in
+++ b/gnu-apl.d/preferences.in
@@ -277,9 +277,9 @@
 # LIBREF-0 /home/xyz/my-own-libs
 # LIBREF-1 /home/xyz/my-group-libs
 # LIBREF-2 /group/abc/other-libs
-  LIBREF-3 @prefix@/lib/apl/wslib3
-  LIBREF-4 @prefix@/lib/apl/wslib4
-  LIBREF-5 @prefix@/lib/apl/wslib5
+  LIBREF-3 @apl_libdir@/apl/wslib3
+  LIBREF-4 @apl_libdir@/apl/wslib4
+  LIBREF-5 @apl_libdir@/apl/wslib5
 # LIBREF-6 /usr/lib/gnu-apl/lib-6
 # LIBREF-7 /usr/lib/gnu-apl/lib-7
 # LIBREF-8 /usr/lib/gnu-apl/lib-8
