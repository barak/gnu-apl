 src/Quad_CR.cc |  9 +++++----
 src/Value.cc   |  4 ++--
 src/Value.hh   | 23 +++++++++++++++++++++++
 4 files changed, 36 insertions(+), 10 deletions(-)

diff --git a/src/Archive.cc b/src/Archive.cc
index 5e73734..a3c14eb 100644
--- a/src/Archive.cc
+++ b/src/Archive.cc
@@ -234,7 +234,7 @@ const Cell * C = &v.get_cfirst();
 int space = do_indent();
    if (v.is_packed())   // Value has a packed (non-Cell) ravel
       {
-        const uint8_t * bytes = reinterpret_cast<const uint8_t *>(C);
+        const uint8_t * bytes = v.get_packed_bytes();
         const ShapeItem byte_count = (len + 7)/8;
 
         // print the start of the XML element
@@ -252,7 +252,7 @@ int space = do_indent();
         loop(b, byte_count)   // print with max. 64 bytes per line
             {
               if (b && (b & 0x3F) == 0)   outf << "\n    " << UNI_PAD_U9;
-              outf << (bytes[b] & 0xFF);
+              outf << setw(2) << (bytes[b] & 0xFF);
             }
         outf << nohex << "\"/>" << endl;
         --indent;
@@ -1952,11 +1952,13 @@ char **pend = reinterpret_cast<char **>(&end);
 
         case UNI_PAD_U9: // packed boolean,         e.g. ⁹
              Assert(Z.is_packed());
-             for (;;)
+             for (ShapeItem byte_idx = 0;;)
                  {
                    const uint8_t c0 = input[0];
                    const uint8_t c1 = input[1];
                    if (c0 <= ' ')    { ++input;   continue; }   // whitespace
+                   if (c0 == 0xE2 && c1 == 0x81 && uint8_t(input[2]) == 0xB9)
+                      { input += 3;   continue; }   // ⁹ on continuation line
                    if (c0 == '"')   return input + 1;   // end of ravel
 
                    const char cc[3] = { char(c0), char(c1), 0 };
@@ -1966,7 +1968,7 @@ char **pend = reinterpret_cast<char **>(&end);
 
                    const int converted = end - cc;
                    if (converted == 0)   return input;   // nothing converted
-                   Z.next_ravel_Byte(byte);              // > 0 bytes converted
+                   Z.set_packed_byte(byte_idx++, byte);   // > 0 bytes converted
                    if (converted == 1)   return input + 1;
                  }
 
