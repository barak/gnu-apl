diff --git a/src/Value.hh b/src/Value.hh
index 5e0ebff..ef16b70 100644
--- a/src/Value.hh
+++ b/src/Value.hh
@@ -534,6 +534,21 @@ public:
    static const Cell & cell_fetcher(ShapeItem offset, const Cell * ravel)
       { return ravel[offset]; }
 
+   /// store a 64-bit chunk of a packed ravel at \b dest. Packed ravels
+   /// are accessed bytewise (bit b is bit b&7 of byte b>>3), so the
+   /// chunk is stored little endian regardless of the host byte order.
+   static void store_packed_chunk(uint64_t * dest, uint64_t chunk)
+      {
+        uint8_t * bytes = reinterpret_cast<uint8_t *>(dest);
+        loop(b, 8)   { bytes[b] = chunk & 0xFF;   chunk >>= 8; }
+      }
+
+   /// return the bytes of a packed ravel. Note that get_cfirst() and
+   /// friends of a packed value return static boolean cells, not a
+   /// pointer into the ravel.
+   const uint8_t * get_packed_bytes() const
+      { Assert(is_packed());   return reinterpret_cast<const uint8_t *>(ravel); }
+
    /// return the offset'th ravel cell (of an pack'ed ravel)
    static const Cell & packed_fetcher(ShapeItem offset, const Cell * ravel)
       { return 1 << (offset & 7) &
@@ -607,6 +622,14 @@ public:
    /// case ravel is a uint8_t * and not a Cell * !!!
    inline void next_ravel_Byte(uint8_t byte);
 
+   /// set byte \b idx of a packed ravel to \b byte
+   void set_packed_byte(ShapeItem idx, uint8_t byte)
+      {
+        Assert(is_packed());
+        Assert(idx < (nz_element_count() + 7) >> 3);
+        reinterpret_cast<uint8_t *>(ravel)[idx] = byte;
+      }
+
    /// initialize the next ravel cell with a pointer to another Cell
    inline void next_ravel_Lval(Cell * target, Value * target_owner);
 
