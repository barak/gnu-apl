+const uint8_t * bits = B->get_packed_bytes();
 
    loop(b, B_len)   Z->next_ravel_Int((bits[b >> 3] & 1ULL << (b & 7)) ? 1 : 0);
 
-   return Idx0(LOC);
+   Z->check_value(LOC);
+   return Z;
 }
