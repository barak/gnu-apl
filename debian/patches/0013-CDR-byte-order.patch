From: "Barak A. Pearlmutter" <barak+git@pearlmutter.net>
Date: Sun, 1 Nov 2026 16:00:00 +0000
Subject: CDR: decode ravel items in the byte order they are encoded
MIME-Version: 1.0
Content-Type: text/plain; charset="utf-8"
Content-Transfer-Encoding: 8bit

CDR::fill() writes 4-byte integers, 4-byte Unicode characters, nested
offsets and 8-byte floats little endian, byte by byte.  CDR::from_CDR()
read them back by casting the byte pointer, i.e. in host byte order and
possibly unaligned.  On big-endian hosts (s390x, sparc64, ppc64, ...)
this byte-swaps every value, so 12 ⎕CR 11 ⎕CR B ≢ B and shared
variables (which travel as CDR) arrive corrupted, e.g. 2 → 33554432.
The unaligned 8-byte loads can also trap on strict-alignment CPUs.

In addition, a scalar Unicode character inside a nested CDR was read
big endian (get_4_be) although written little endian, corrupting it on
all architectures:  ⎕UCS 2⊃12 ⎕CR 11 ⎕CR 1 '⍴' gave 1948450816.

The AP210 auxiliary processor had the same problem decoding the
integers of its command variable, so on big-endian hosts every AP210
command was rejected as an invalid subcommand.

Add CDR_header::get_le32() and CDR::get_4_le(), get_8_le() and
get_float_le() helpers that assemble values byte by byte, and use them
throughout from_CDR() and in AP210.

Forwarded: yes
---
 src/APs/AP210.cc  |  9 ++++-----
 src/CDR.cc        | 32 +++++++++++---------------------
 src/CDR.hh        | 18 ++++++++++++++++++
 src/CDR_string.hh |  8 ++++++++
 4 files changed, 41 insertions(+), 26 deletions(-)

diff --git a/src/APs/AP210.cc b/src/APs/AP210.cc
index 559bd93..4715da0 100644
--- a/src/APs/AP210.cc
+++ b/src/APs/AP210.cc
@@ -312,11 +312,10 @@ const int nelm = cdr.header().get_nelm();
       }
    else if (cdr.get_type() == CDR_INT32)
       {
-        const uint32_t * ravel =
-                         reinterpret_cast<const uint32_t *>(cdr.ravel());
-        op                        = ravel[0];
-        if (nelm >= 2)   ctx.rec_num  = ravel[1];
-        if (nelm >= 3)   ctx.rec_size = ravel[2];
+        const uint8_t * ravel = cdr.ravel();
+        op                        = CDR_header::get_le32(ravel);
+        if (nelm >= 2)   ctx.rec_num  = CDR_header::get_le32(ravel + 4);
+        if (nelm >= 3)   ctx.rec_size = CDR_header::get_le32(ravel + 8);
       }
    else   // neither int nor bool:
       {
diff --git a/src/CDR.cc b/src/CDR.cc
index 60101d5..6db1808 100644
--- a/src/CDR.cc
+++ b/src/CDR.cc
@@ -353,7 +353,7 @@ const uint8_t * ravel = data + 16 + 4*rank;
       {
         loop(n, nelm)
            {
-             APL_Integer d = *reinterpret_cast<const uint32_t *>(ravel + 4*n);
+             APL_Integer d = get_4_le(ravel + 4*n);
              if (d & 0x80000000)   d |= 0xFFFFFFFF00000000ULL;
              Z->next_ravel_Int(d);
            }
@@ -362,8 +362,7 @@ const uint8_t * ravel = data + 16 + 4*rank;
       {
         loop(n, nelm)
            {
-             const APL_Float v =
-                  *reinterpret_cast<const APL_Float *>(ravel + 8*n);
+             const APL_Float v = get_float_le(ravel + 8*n);
              Z->next_ravel_Float(v);
            }
       }
@@ -371,10 +370,8 @@ const uint8_t * ravel = data + 16 + 4*rank;
       {
         loop(n, nelm)
            {
-             const APL_Float vr =
-                  *reinterpret_cast<const APL_Float *>(ravel + 16*n);
-             const APL_Float vi =
-                  *reinterpret_cast<const APL_Float *>(ravel + 16*n + 8);
+             const APL_Float vr = get_float_le(ravel + 16*n);
+             const APL_Float vi = get_float_le(ravel + 16*n + 8);
              Z->next_ravel_Complex(vr, vi);
            }
       }
@@ -391,7 +388,7 @@ const uint8_t * ravel = data + 16 + 4*rank;
       {
         loop(n, nelm)
            {
-             const uint32_t d = *reinterpret_cast<const uint32_t *>(ravel+4*n);
+             const uint32_t d = get_4_le(ravel + 4*n);
              Z->next_ravel_Char(Unicode(d));
            }
       }
@@ -399,8 +396,7 @@ const uint8_t * ravel = data + 16 + 4*rank;
       {
         loop(n, nelm)
             {
-              APL_Integer offset =
-                         *reinterpret_cast<const uint32_t *>(ravel + 4*n);
+              APL_Integer offset = get_4_le(ravel + 4*n);
               const uint8_t * sub_data = data + offset;
               const uint32_t sub_vtype = sub_data[12];
               const sRank sub_rank = sub_data[13];
@@ -419,8 +415,7 @@ const uint8_t * ravel = data + 16 + 4*rank;
 
                    if (sub_vtype == 1)        // 4 byte int
                       {
-                        APL_Integer d = *reinterpret_cast<const uint32_t *>
-                                                         (sub_ravel);
+                        APL_Integer d = get_4_le(sub_ravel);
                         if (d & 0x80000000)   d |= 0xFFFFFFFF00000000ULL;
                         Z->next_ravel_Int(d);
                         continue;   // next n
@@ -428,19 +423,14 @@ const uint8_t * ravel = data + 16 + 4*rank;
 
                    if (sub_vtype == 2)        // 8 byte real
                       {
-                        Z->next_ravel_Float(
-                                        *reinterpret_cast<const APL_Float *>
-                                                                (sub_ravel));
+                        Z->next_ravel_Float(get_float_le(sub_ravel));
                         continue;   // next n
                       }
 
                    if (sub_vtype == 3)        // 16 byte complex
                       {
-                        Z->next_ravel_Complex(
-                                        *reinterpret_cast<const APL_Float *>
-                                                         (sub_ravel),
-                                        *reinterpret_cast<const APL_Float *>
-                                                          (sub_ravel + 8));
+                        Z->next_ravel_Complex(get_float_le(sub_ravel),
+                                              get_float_le(sub_ravel + 8));
                         continue;   // next n
                       }
 
@@ -452,7 +442,7 @@ const uint8_t * ravel = data + 16 + 4*rank;
 
                    if (sub_vtype == 5)        // 4 byte Unicode
                       {
-                        Z->next_ravel_Char(Unicode(get_4_be(sub_ravel)));
+                        Z->next_ravel_Char(Unicode(get_4_le(sub_ravel)));
                         continue;   // next n
                       }
 
diff --git a/src/CDR.hh b/src/CDR.hh
index c6b5e3f..458d6c0 100644
--- a/src/CDR.hh
+++ b/src/CDR.hh
@@ -62,6 +62,24 @@ public:
                  return ret | get_4_be(data + 4);
       }
 
+   /// return 4 bytes starting at \b data in little endian byte order
+   /// (the byte order in which fill() stores ravel items)
+   static uint32_t get_4_le(const uint8_t * data)
+      { return CDR_header::get_le32(data); }
+
+   /// return 8 bytes starting at \b data in little endian byte order
+   static uint64_t get_8_le(const uint8_t * data)
+      { return get_4_le(data) | uint64_t(get_4_le(data + 4)) << 32; }
+
+   /// return the APL_Float stored at \b data in little endian byte order
+   static APL_Float get_float_le(const uint8_t * data)
+      {
+        const uint64_t bits = get_8_le(data);
+        APL_Float ret;
+        memcpy(&ret, &bits, sizeof(ret));
+        return ret;
+      }
+
 protected:
    /// fill result with the bytes of the CDR of \b value
    static void fill(CDR_string & result, int type, int len, const Value & val);
diff --git a/src/CDR_string.hh b/src/CDR_string.hh
index 99f42d5..dc46ba3 100644
--- a/src/CDR_string.hh
+++ b/src/CDR_string.hh
@@ -58,6 +58,14 @@ struct CDR_header
                  ret |= *data++;
         return ret;
       }
+
+   /// convert little endian 32 bit value to 32 bit host value. CDR
+   /// headers are big endian, but ravel items are stored little endian.
+   static uint32_t get_le32(const uint8_t * data)
+      {
+        return  uint32_t(data[0])        | uint32_t(data[1]) <<  8
+             |  uint32_t(data[2]) << 16  | uint32_t(data[3]) << 24;
+      }
 };
 
 /// a string containing a CDR record
