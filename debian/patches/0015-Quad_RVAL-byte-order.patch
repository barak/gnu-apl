From: "Barak A. Pearlmutter" <barak+git@pearlmutter.net>
Date: Tue, 3 Nov 2026 21:00:00 +0000
Subject: ⎕RVAL: build random floats independently of host byte order

Quad_RVAL::random_ieee() built a double in [1,2) by storing its sign,
exponent and fraction into the bytes of a double/char[8] union in
little-endian order.  On big-endian hosts the exponent ends up in the
low-order bytes, so ⎕RVAL returns garbage floats (e.g. 5.29E45 ¯1
¯9.5E212), and Quad_RVAL.tc and Domino_stress.tc fail.  Assemble the
bits in a uint64_t instead and memcpy() them into the double.  The same
bits of the random number are used, so on little-endian hosts the
sequence of random numbers is unchanged.

Forwarded: no
---
--- a/src/Quad_RVAL.cc
+++ b/src/Quad_RVAL.cc
@@ -22,6 +22,7 @@
 */
 
 #include <stdlib.h>
+#include <string.h>
 
 #include "Common.hh"
 #include "ComplexCell.hh"
@@ -586,35 +587,31 @@
 double
 Quad_RVAL::random_ieee()
 {
-union { double f;
-        char bytes[8];
-      } u;
+double f;
    do {
         const int64_t rand64 = rand17()
                              ^ (rand17() << 16)
                              ^ (rand17() << 32)
                              ^ (rand17() << 48);
-        
+
         enum { BIAS     = 1023,          // IEEE
                EXPO     = 0 + BIAS,      // 2^0
-               EXPO_LSB = EXPO & 0x0F,   // 0..15
-               EXPO_MSB = EXPO >> 4      // 0..15
              };
 
-        u.bytes[7] = EXPO_MSB;                // SIGN + and exponent MSBs
-        u.bytes[6] = (EXPO_LSB << 4)          // exponent LSBs
-                   | (rand64 >> 56 & 0x0F);   // 52 bit fraction MSBs
-        u.bytes[5] = rand64 >> 40;            // 52 bit fraction
-        u.bytes[4] = rand64 >> 32;            // 52 bit fraction
-        u.bytes[3] = rand64 >> 24;            // 52 bit fraction
-        u.bytes[2] = rand64 >> 16;            // 52 bit fraction
-        u.bytes[1] = rand64 >>  8;            // 52 bit fraction
-        u.bytes[0] = rand64 >>  0;            // 52 bit fraction LSBs
-      } while (!isnormal(u.f));
+        // sign +, exponent EXPO, and a random 52 bit fraction (bits 0-47 and
+        // 56-59 of rand64). Assemble the bits in a uint64_t and memcpy() them
+        // into f, rather than storing bytes into a union, so that the result
+        // does not depend on the host byte order.
+        //
+        const uint64_t bits = uint64_t(EXPO) << 52
+                            | (uint64_t(rand64) >> 56 & 0x0F) << 48
+                            | (uint64_t(rand64) & 0xFFFFFFFFFFFFULL);
+        memcpy(&f, &bits, sizeof(f));
+      } while (!isnormal(f));
 
-   // at this point: 1.0 < u.f < 2.0
+   // at this point: 1.0 < f < 2.0
    //
-   return u.f - 1.0;
+   return f - 1.0;
 }
 //----------------------------------------------------------------------------
 void
