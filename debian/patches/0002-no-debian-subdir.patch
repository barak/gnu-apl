From: "Barak A. Pearlmutter" <barak+git@pearlmutter.net>
Date: Sun, 1 Nov 2026 13:32:54 +0000
Subject: do not configure debian/ subdirectory

configure.ac and Makefile.am treat debian/ as an automake subdirectory,
so that upstream's own debian/ directory is included in "make dist".
That directory is not in the imported source (see debian/import-trunk)
and the Debian packaging replaces it, so automake fails with "required
file 'debian/Makefile.in' not found".

Drop debian/Makefile and debian/source/Makefile from AC_CONFIG_FILES
and debian from DIST_SUBDIRS.

Forwarded: not-needed
---
 Makefile.am  | 2 +-
 configure.ac | 2 --
 2 files changed, 1 insertion(+), 3 deletions(-)

--- a/Makefile.am
+++ b/Makefile.am
@@ -7,7 +7,7 @@
 SUBDIRS		= $(APL_DIRS)
 SUBDIRS		+= build Claude doc erlang gnu-apl.d HOWTOs
 SUBDIRS		+= src support-files tools websock
-DIST_SUBDIRS	= $(SUBDIRS) rpm debian
+DIST_SUBDIRS	= $(SUBDIRS) rpm
 
 dist_doc_DATA = 							\
 		README								\
--- a/configure.ac
+++ b/configure.ac
@@ -471,8 +471,6 @@
 AC_CONFIG_FILES([Makefile
                  build/Makefile
                  Claude/Makefile
-                 debian/Makefile
-                 debian/source/Makefile
                  doc/Makefile
                  doc/DALY/Makefile
                  erlang/Makefile
